execution_count":1,"outputs":[]},{"cell_type":"code","source":["\n","import gradio as gr\n","\n","from deep_translator import GoogleTranslator\n","\n","from textblob import TextBlob\n","\n","from gtts import gTTS\n","\n","\n","# Translation Function\n","def translate_text(text, target_lang):\n","\n","    translated = GoogleTranslator(\n","        source='auto',\n","        target=target_lang\n","    ).translate(text)\n","\n","    # Emotion Detection\n","    sentiment = TextBlob(text).sentiment.polarity\n","\n","    if sentiment > 0:\n","        emotion = \"Positive 😊\"\n","\n","    elif sentiment < 0:\n","        emotion = \"Negative 😔\"\n","\n","    else:\n","        emotion = \"Neutral 😐\"\n","\n","    # Voice Output\n","    tts = gTTS(translated)\n","\n","    tts.save(\"voice.mp3\")\n","\n","    return translated, emotion, \"voice.mp3\"\n","\n","\n","# Languages\n","languages = [\n","    \"english\",\n","    \"hindi\",\n","    \"telugu\",\n","    \"french\",\n","    \"german\",\n","    \"spanish\"\n","]\n","\n","\n","# Beautiful UI\n","with gr.Blocks() as app:\n","\n","    gr.Markdown(\n","        \"\"\"\n","        # 🌍 AI Translation Assistant\n","\n","        ### 🚀 Smart Translation + Emotion Detection + Voice\n","        \"\"\"\n","    )\n","\n","    text_input = gr.Textbox(\n","        label=\"Enter Text\"\n","    )\n","\n","    lang_input = gr.Dropdown(\n","        choices=languages,\n","        value=\"hindi\",\n","        label=\"Target Language\"\n","    )\n","\n","    translate_btn = gr.Button(\"🚀 Translate\")\n","\n","    translated_output = gr.Textbox(\n","        label=\"Translated Text\"\n","    )\n","\n","    emotion_output = gr.Textbox(\n","        label=\"Detected Emotion\"\n","    )\n","\n","    audio_output = gr.Audio(\n","        label=\"Voice Output\"\n","    )\n","\n","    translate_btn.click(\n","        translate_text,\n","\n","        inputs=[\n","            text_input,\n","            lang_input\n","        ],\n","\n","        outputs=[\n","            translated_output,\n","            emotion_output,\n","            audio_output\n","        ]\n","    )\n","\n","app.launch()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":660},"id":"8xs1WC4kufeE","executionInfo":{"status":"ok","timestamp":1780292928817,"user_tz":-330,"elapsed":1661,"user":{"displayName":"ABHIGNAREDDY KUNDURU","userId":"16710840454289741295"}},"outputId":"c85e63e4-9035-4839-d526-c723dfc0e6f3"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Setting queue=True in a Colab notebook requires sharing enabled. Setting `share=True` (you can turn this off by setting `share=False` in `launch()` explicitly).\n","\n","Colab notebook detected. To show errors in colab notebook, set debug=True in launch()\n","IMPORTANT: You are using gradio version 3.50.2, however version 4.44.1 is available, please upgrade.\n","--------\n","Running on public URL: https://191925876feee34b8c.gradio.live\n","\n","This share link expires in 72 hours. For free permanent hosting and GPU upgrades, run `gradio deploy` from Terminal to deploy to Spaces (https://huggingface.co/spaces)\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<div><iframe src=\"https://191925876feee34b8c.gradio.live\" width=\"100%\" height=\"500\" allow=\"autoplay; camera; microphone; clipboard-read; clipboard-write;\" frameborder=\"0\" allowfullscreen></iframe></div>"]},"metadata":{}},{"output_type":"execute_result","data":{"text/plain":[]},"metadata":{},"execution_count":2}]}]}